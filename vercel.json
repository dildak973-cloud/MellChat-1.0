{
  "version": 2,
  "builds": [
    { "src": "app.js", "use": "@vercel/node", "config": { "maxDuration": 10 } },
    { "src": "index.html", "use": "@vercel/static" },
    { "src": "shim.js", "use": "@vercel/static" },
    { "src": "config.js", "use": "@vercel/static" },
    { "src": "send.png", "use": "@vercel/static" },
    { "src": "clip.png", "use": "@vercel/static" }
  ],
  "routes": [
    { "src": "/api/([^/]+)", "dest": "/app.js?op=$1" },
    { "src": "/upload", "dest": "/app.js?op=upload" },
    { "src": "/f/([^/]+)", "dest": "/app.js?op=file&id=$1" },
    { "src": "/", "dest": "/index.html" },
    { "handle": "filesystem" }
  ]
}
